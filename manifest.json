{
  "manifest_version": 3,
  "name": "KingOfTime extension",
  "version": "1.0.5",
  "description": "King Of Time 便利ツール",
  "permissions": [
    "background", "scripting", "tabs", "storage"
  ],
  "host_permissions": [
    "*://api.kingtime.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://s2.ta.kingoftime.jp/admin/*"],
      "css": ["improveSelectJob.css", "./work-time-visualizer/work-time-visualizer.css"],
      "js": ["improveSelectJob.js", "improveInputTime.js", "events.js", "contents.js", "./work-time-visualizer/work-time-visualizer.js"]
    }
  ]
}
